

# 容器内必须监听 0.0.0.0，否则宿主发布的端口进不来
HOST=0.0.0.0
PORT=4100
LOG_LEVEL=info
RETRIES_PER_UPSTREAM=1
DB_POOL_MAX=10

# 跨段寻址只写容器名 + 内网端口，不走公网端口
DATABASE_URL=postgresql://llm_gateway:<密码>@postgres:5432/llm_gateway

# ⚠️ 必须是当前这个值，一个字符都不能改：库里 providers.api_key_ciphertext 是用它加密的
GATEWAY_SECRET=

# 管理面板
ADMIN_PASSWORD=
# 面板来源白名单。容器里请求的 remoteAddress 是网桥网关 IP，
# 用 `docker exec llm-gateway_backend ip route | grep default` 查出来填这里：
#   default via 172.18.0.1 dev eth0
ADMIN_ALLOWED_IPS=127.0.0.1,::1
