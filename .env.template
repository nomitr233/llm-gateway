# 复制成 .env 后填值：Copy-Item .env.template .env

# ---- 网关自身 ----
# 对外提供服务时改成 0.0.0.0
HOST=127.0.0.1
PORT=8787
# 同一个上游上最多再重试几次（0 = 失败直接切下一个上游）
RETRIES_PER_UPSTREAM=1

# ---- 数据库（可选，不配也能正常代理）----
# Python 的 SQLAlchemy 写法 postgresql+asyncpg:// 会被自动纠正成 postgresql://
# 密码里的 @ : / 等字符要写成 %40 这样的百分号编码
DATABASE_URL=
DB_POOL_MAX=10

# ---- 管理面板（可选；不设置就不开面板）----
# 至少 8 位。面板只允许本机访问，且用这个密码登录。
ADMIN_PASSWORD=

# ---- 上游（按顺序故障转移，槽位 1..16）----
UPSTREAM_1_NAME=openai
UPSTREAM_1_KIND=openai
UPSTREAM_1_BASE_URL=https://api.openai.com/v1
UPSTREAM_1_API_KEY=
# 逗号分隔；留空表示这个上游兜底，任何模型都接
UPSTREAM_1_MODELS=gpt-4o-mini,gpt-4o
UPSTREAM_1_TIMEOUT_MS=120000

# 再加一个上游就往后排，前面挂了会自动切过来：
# UPSTREAM_2_NAME=deepseek
# UPSTREAM_2_BASE_URL=https://api.deepseek.com/v1
# UPSTREAM_2_API_KEY=
# UPSTREAM_2_MODELS=deepseek-chat
